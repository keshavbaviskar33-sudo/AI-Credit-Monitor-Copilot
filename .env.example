# Copy to .env and fill in real values. .env is gitignored; never commit it.

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text (human-readable) | json (structured, one object per line)
LOG_FORMAT=text

# Required to call the SEC EDGAR APIs: SEC asks for a descriptive User-Agent
# identifying the requester (see docs/data_feasibility.md). Format suggested
# by SEC: "Sample Company Name AdminContact@example.com".
SEC_USER_AGENT=

# EDGAR access rules: <=10 requests/second per caller. Leave headroom below that.
SEC_REQUEST_TIMEOUT_SECONDS=10
SEC_MAX_REQUESTS_PER_SECOND=8

# --- Not used until later phases; safe to leave blank for now ---

# Phase 13/15: append-only SQLite persistence.
DATABASE_URL=sqlite:///./data/credit_risk_copilot.db

# Phase 12: single grounded synthesis call. Provider/key TBD (PRD open
# question Q3, docs/product_requirements.md).
LLM_PROVIDER=
LLM_API_KEY=
